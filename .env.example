# ===========================================
# Distributed Ride Dispatch Platform - Config
# ===========================================
# Copy this file to .env and adjust values

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ridedispatch
POSTGRES_PASSWORD=ridedispatch
POSTGRES_DB=ridedispatch
POSTGRES_SSLMODE=disable

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Temporal ----
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ride-dispatch

# ---- Service Ports ----
TRIP_SERVICE_PORT=8081
DRIVER_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
GATEWAY_PORT=8080

# ---- Driver Matching ----
MATCH_MAX_RADIUS_KM=5.0
MATCH_MAX_CANDIDATES=10
MATCH_DISTANCE_WEIGHT=0.4
MATCH_RATING_WEIGHT=0.25
MATCH_ACCEPTANCE_RATE_WEIGHT=0.2
MATCH_IDLE_TIME_WEIGHT=0.15

# ---- Workflow Timeouts ----
DRIVER_RESPONSE_TIMEOUT_SEC=30
MAX_DRIVER_ATTEMPTS=3
